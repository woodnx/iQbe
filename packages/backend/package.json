{
  "name": "backend",
  "private": true,
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "exports": {
    "./rpc": {
      "types": "./dist/app.d.ts"
    },
    "./dto": {
      "types": "./dist/types/dto.d.ts"
    }
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "watch:": "tsup --config tsup.config.ts --watch --onSuccess 'node dist/index.js'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:exe": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset",
    "test:integration": "API_MYSQL_TESTS=1 vitest run src/api.integration.test.ts --no-file-parallelism",
    "indexes:check": "tsx src/scripts/checkApiIndexes.ts",
    "test:benchmark": "API_BENCHMARK=1 pnpm run test:integration"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "csv": "^6.6.0",
    "dayjs": "^1.11.21",
    "hashids": "^2.3.0",
    "hono": "^4.13.14",
    "jsonwebtoken": "^9.0.3",
    "knex": "^2.5.1",
    "kysely": "^0.29.2",
    "lodash": "^4.18.1",
    "mysql2": "^3.22.5",
    "nanoid": "^3.3.15",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uid": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^10.28.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "prisma": "^6.19.3",
    "prisma-kysely": "^1.8.0",
    "testcontainers": "^10.28.0",
    "tsc-alias": "^1.8.17",
    "tsc-watch": "^6.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}

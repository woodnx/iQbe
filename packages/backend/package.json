{
  "name": "backend",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/index.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchAll",
    "dev": "tsx watch src/index.ts",
    "watch:": "tsup --config tsup.config.ts --watch --onSuccess 'node dist/index.js'",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:exe": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset",
    "test:integration": "API_MYSQL_TESTS=1 node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testPathPatterns=api.integration.test.ts",
    "indexes:check": "tsx src/scripts/checkApiIndexes.ts",
    "test:benchmark": "API_BENCHMARK=1 pnpm run test:integration"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "csv": "^6.6.0",
    "dayjs": "^1.11.21",
    "hashids": "^2.3.0",
    "hono": "^4.13.13",
    "jsonwebtoken": "^9.0.3",
    "knex": "^2.5.1",
    "kysely": "^0.29.2",
    "lodash": "^4.18.1",
    "mysql2": "^3.22.5",
    "nanoid": "^3.3.15",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uid": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@testcontainers/mysql": "^10.28.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "prisma-kysely": "^1.8.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.17",
    "tsc-watch": "^6.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./rpc": {
      "types": "./dist/app.d.ts"
    },
    "./dto": {
      "types": "./dist/types/dto.d.ts"
    }
  }
}

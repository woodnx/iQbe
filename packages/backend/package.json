{
  "name": "backend",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node ./dist/index.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchAll",
    "watch": "tsc-watch --noClear --onSuccess \"node watch.mjs\"",
    "watch:": "tsup --config tsup.config.ts --watch --onSuccess 'node dist/index.js'",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:exe": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "api": "file:../spec",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv": "^6.6.0",
    "dayjs": "^1.11.21",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.6.2",
    "express-query-boolean": "^2.0.0",
    "express-query-int": "^3.0.0",
    "hashids": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^2.5.1",
    "kysely": "^0.29.2",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "nanoid": "^3.3.15",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uid": "^2.0.2"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^10.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "prisma-kysely": "^1.8.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.17",
    "tsc-watch": "^6.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
